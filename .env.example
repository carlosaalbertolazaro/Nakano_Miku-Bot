# Copiá este archivo a .env y completá los valores reales. Nunca subas .env al repo.

NODE_ENV=production

# --- Módulo de IA (.ai / .miku) — key gratis en console.groq.com ---
GROQ_API_KEY=

# --- Respaldo de IA cuando Groq falla en interacción directa (opcional) ---
# key gratis en build.nvidia.com (deepseek-ai/deepseek-v4-pro, free tier)
NVIDIA_API_KEY=

# --- Servidor de Minecraft (Aternos) — comando .aternos + aviso cuando se prende ---
# Poné solo el host (el mismo que escribís en el cliente de Minecraft para conectarte),
# ej: chafacraft-Twzs.aternos.me — el puerto casi nunca hace falta, se resuelve
# solo vía el registro SRV de Aternos (que además cambia cada vez que reinicia el server).
ATERNOS_SERVER_HOST=
ATERNOS_SERVER_PORT=

# --- Despliegue en Render / Nube (Opcional - solo si usas Render) ---
# Puerto asignado por Render automáticamente (no hace falta tocarlo en Render)
# PORT=3000

# Cadena de conexión de MongoDB Atlas (cluster gratis M0, sin tarjeta)
# Necesario en Render para que no se pierda la sesión ni la base de datos al reiniciar el contenedor
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Número del bot para generar código de vinculación en los logs de Render (sin + ni espacios, ej: 5491123456789)
PAIRING_NUMBER=
